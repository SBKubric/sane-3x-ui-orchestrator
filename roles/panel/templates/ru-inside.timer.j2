# {{ ansible_managed }} (3ax-ui-orchestrator, role panel)
# Daily, after golukon/russia-only-geosite's release (~03:30 UTC); a missed run (box down) runs at boot.
[Unit]
Description=Daily refresh of geosite ru-inside for the panel's xray

[Timer]
OnCalendar={{ panel_ru_inside_on_calendar }}
RandomizedDelaySec={{ panel_ru_inside_randomized_delay }}
Persistent=true

[Install]
WantedBy=timers.target
