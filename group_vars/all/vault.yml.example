---
# Template for group_vars/all/vault.yml (git-ignored). Copy, fill, encrypt:
#   cp group_vars/all/vault.yml.example group_vars/all/vault.yml
#   ansible-vault encrypt group_vars/all/vault.yml
# Shared by every inventory profile (playbook-level group_vars).

# Panel account, applied by role panel via `x-ui setting` right after install (#2).
panel_user: admin
panel_password: change-me
panel_port: 2053
# Web base path with leading and trailing slash, at least 4 characters between them, e.g. /s3cr3t/.
panel_base_path: /change-me/

# mon-server admin account (`mon-server admin set`), role monserver (#4).
mon_admin_user: monadmin
mon_admin_password: change-me

# One Telegram bot and chat for both the panel and mon-server (#2, #4); leave both empty to skip.
tg_bot_token: "123456:change-me"
tg_chat_id: "-1000000000000"

# WARP+ license key for the panel's WARP (#41), optional; empty = the free account.
warp_license: ""

# DNSExit API key for the records of dns_zone (role showcase: sub.<dns_zone>, #53), optional; empty = the records are
# only read, the owner sets them by hand.
dnsexit_api_key: ""

# Real host addresses: inventory hostname → public IPv4. The only place they are kept; never put an address
# into an inventory, README or test. A host without an entry is reached through its ssh alias.
vault_hosts:
  real: 203.0.113.10
  bridge: 203.0.113.11
  proxy: 203.0.113.12
  proxy2: 203.0.113.13
  mon-server: 203.0.113.14
  mon-client: 203.0.113.15
  subgateway: 203.0.113.16
